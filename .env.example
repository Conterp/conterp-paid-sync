#===============================
# 🌐 ALTERDATA (Bimer)
#===============================
# Usuário e senha de acesso à API da Alterdata
ALTERDATA_USER=usuario_exemplo
ALTERDATA_PASS=senha_exemplo123
# URL base da API da Alterdata (geralmente termina com ".alterdata.cloud")
ALTERDATA_BASE_URL=https://empresaexemplo.alterdata.cloud


#===============================
# 💼 MONDAY.COM
#===============================
# URL base da API do Monday
MONDAY_BASE_URL=https://api.monday.com/v2
# Token de autenticação (gerado no perfil do usuário no Monday)
MONDAY_API_TOKEN=seu_token_aqui
# ID do board de destino (número visível na URL do board)
MONDAY_BOARD_ID=1234567890
# ID da coluna onde o campo "ID" é armazenado
MONDAY_COLUMN_ID=text_mktkv6ct


#===============================
# 🗂️ GRUPOS DO BOARD (IDs)
#===============================
# Group ID para lançamentos padrão
MONDAY_GROUP_PADRAO=group_padrao_id
# Group ID para lançamentos com Nº Título iniciando com "MOVBCO"
MONDAY_GROUP_MOVBCO=group_movbco_id

#===============================
# N8N
#===============================
N8N_WEBHOOK_URL=https://seu_n8n.cloud/webhook/seu_endpoint
N8N_WEBHOOK_TIMEOUT=30